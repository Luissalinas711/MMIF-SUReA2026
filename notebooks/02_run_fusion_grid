# Only the DenseFuse row needs this
def setup_densefuse(repo_path):
    densefuse_repo = f'{repo_path}/densefuse-pytorch'

    if not os.path.isdir(densefuse_repo):
        os.system(f'git clone https://github.com/hli1221/densefuse-pytorch {densefuse_repo}')

    os.environ['DENSEFUSE_REPO'] = densefuse_repo

    has_network = os.path.isfile(f'{densefuse_repo}/net.py')
    has_weights = os.path.isfile(f'{densefuse_repo}/models/densefuse_gray.model')
    print(f'densefuse repo ready: network {has_network}, weights {has_weights}')


